<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OrthoStreamXP.Mac</AssemblyName>
    <RootNamespace>OrthoStreamXP</RootNamespace>
    <Version>1.3.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OrthoStreamXP.Core/OrthoStreamXP.Core.csproj" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.153.1" />
    <InternalsVisibleTo Include="OrthoStreamXP.Core.Tests" />
    <Content Include="../../platform/macos/*.py;../../platform/macos/requirements.txt" Link="bridge/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../platform/macos/donor/*.py;../../platform/macos/donor/*.md;../../platform/macos/donor/*.json;../../platform/macos/donor/LICENSE-*" Link="bridge/donor/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
</Project>
